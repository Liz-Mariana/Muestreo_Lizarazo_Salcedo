N <- 4000
# Crear vectores vacios para guardar las muestras
muestraA <- numeric(0)
muestraB <- numeric(0)
candidatosA <- 0
candidatosB <- 0
muestraA <- numeric(0)
muestraB <- numeric(0)
candidatosA <- 0
candidatosB <- 0
N <- 4000
# Repetir hasta conseguir 4000 valores aceptados
while (length(muestraA) < N) {
# Generar un candidato uniforme entre 0 y 1
y <- runif(1)
# Calcular la probabilidad de aceptacion
p <- f(y) / (cA * gA(y))
# Comprobar que la probabilidad este entre 0 y 1
stopifnot(p >= 0, p <= 1)
# Contar el candidato generado
candidatosA <- candidatosA + 1
# Generar un uniforme independiente para decidir
u <- runif(1)
# Aceptar el candidato si u es menor o igual que p
if (u <= p) {
muestraA <- c(muestraA, y)
}
}
