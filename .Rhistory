# 2b. P(T>40) y P(Z=2 | T>40): simulacion vs teoria (Bayes).
estimar_P <- function(datos) {
exced <- datos$T > 40
c(P_T40 = mean(exced),
P_Z2_dado_T40 = mean(datos$Z[exced] == 2),
n_excedentes = sum(exced))
}
calcular_teorico <- function(pesos) {
p1 <- 1 - pnorm(40, mu_T[1], sd_T[1])   # P(T>40 | Z=1)
p2 <- 1 - pnorm(40, mu_T[2], sd_T[2])   # P(T>40 | Z=2)
total <- pesos[1]*p1 + pesos[2]*p2      # probabilidad total
post2 <- pesos[2]*p2/total              # Bayes
c(P_T40 = total, P_Z2_dado_T40 = post2, P_T40_dado_Z1 = p1, P_T40_dado_Z2 = p2)
}
sim0 <- estimar_P(datos0)
teo0 <- calcular_teorico(pesos0)
print(data.frame(medida = c('P(T>40)', 'P(Z=2|T>40)'),
simulada = c(sim0['P_T40'], sim0['P_Z2_dado_T40']),
teorica = c(teo0['P_T40'], teo0['P_Z2_dado_T40']),
diferencia = c(sim0['P_T40'] - teo0['P_T40'],
sim0['P_Z2_dado_T40'] - teo0['P_Z2_dado_T40'])))
print(teo0)
print(sim0['n_excedentes'])
# P(T>40) ~ 0.117 y P(Z=2|T>40) ~ 0.992. Las diferencias son pequenas
# (variabilidad Monte Carlo): con 10.000 datos solo ~1.170 superan 40,
# por eso la probabilidad condicional tiene mayor error relativo.
# Error estandar aproximado de P(T>40):
print(sqrt(teo0['P_T40']*(1 - teo0['P_T40'])/10000))
sim0 <- estimar_P(datos0)
teo0 <- calcular_teorico(pesos0)
print(data.frame(medida = c('P(T>40)', 'P(Z=2|T>40)'),
simulada = c(sim0['P_T40'], sim0['P_Z2_dado_T40']),
teorica = c(teo0['P_T40'], teo0['P_Z2_dado_T40']),
diferencia = c(sim0['P_T40'] - teo0['P_T40'],
sim0['P_Z2_dado_T40'] - teo0['P_Z2_dado_T40'])))
print(teo0)
print(sim0['n_excedentes'])
print(data.frame(medida = c('P(T>40)', 'P(Z=2|T>40)'),
simulada = c(sim0['P_T40'], sim0['P_Z2_dado_T40']),
teorica = c(teo0['P_T40'], teo0['P_Z2_dado_T40']),
diferencia = c(sim0['P_T40'] - teo0['P_T40'],
sim0['P_Z2_dado_T40'] - teo0['P_Z2_dado_T40'])))
print(teo0)
# P(T>40) ~ 0.117 y P(Z=2|T>40) ~ 0.992, solo 1.170 superan 40,
# Error estandar aproximado de P(T>40):
print(sqrt(teo0['P_T40']*(1 - teo0['P_T40'])/10000))
# ---------- 1. Ingreso de los datos ----------
# Escribo los 36 datos en el orden de las tablas:
# primero tiempo 3 h, luego 4 h; dentro de cada tiempo voy por
# concentración (2, 4, 8) y dentro de cada una por presión (400, 500, 650),
# cada celda con sus 2 réplicas.
y <- c(
# Tiempo 3 horas
196.6, 196.0,  197.7, 196.0,  199.8, 199.4,   # A = 2
198.5, 197.2,  196.0, 196.9,  198.4, 197.6,   # A = 4
197.5, 196.6,  195.6, 196.2,  197.4, 198.1,   # A = 8
# Tiempo 4 horas
198.4, 198.6,  199.6, 200.4,  200.6, 200.9,   # A = 2
197.5, 198.1,  198.7, 198.0,  199.6, 199.0,   # A = 4
197.6, 198.4,  197.0, 197.8,  198.5, 199.8    # A = 8
)
# Los factores deben ser "factor" para que R haga un ANOVA
# y no una regresión
A <- factor(rep(rep(c(2, 4, 8), each = 6), times = 2))       # concentración
B <- factor(rep(rep(c(400, 500, 650), each = 2), times = 6)) # presión
C <- factor(rep(c(3, 4), each = 18))                         # tiempo
datos <- data.frame(y, A, B, C)
View(datos)
# Reviso que quedó bien armado: 36 filas y 18 combinaciones x 2 réplicas
str(datos)
table(datos$A, datos$B, datos$C)   # debe dar 2 en todas las casillas
# ---------- 2. (a) ANOVA ----------
# Modelo con los tres efectos principales y todas las interacciones.
# A*B*C equivale a A + B + C + A:B + A:C + B:C + A:B:C
modelo <- aov(y ~ A * B * C, data = datos)
summary(modelo)
# Valores críticos de F para comparar con los F0 de la tabla (alfa = 0.05)
# El error tiene 18 gl = 18 * (2 - 1)
qf(0.95, df1 = 2, df2 = 18)   # para A, B, AC, BC
qf(0.95, df1 = 1, df2 = 18)   # para C
qf(0.95, df1 = 4, df2 = 18)   # para AB y ABC
# Cuadrado medio del error y su raíz (estimación de sigma)
CME <- sum(residuals(modelo)^2) / df.residual(modelo)
CME
sqrt(CME)
# Como la interacción AB salió significativa, miro la tabla A x B
tapply(datos$y, list(datos$A, datos$B), mean)
# Gráfico de interacción A x B (si las líneas no son paralelas
# hay interacción)
interaction.plot(x.factor = datos$B, trace.factor = datos$A,
response = datos$y, type = "b", pch = 19,
xlab = "Presión", ylab = "Resistencia media",
trace.label = "% madera dura",
main = "Interacción Concentración x Presión")
# Medias de las 18 celdas, para escoger las condiciones de operación
medias_celda <- aggregate(y ~ A + B + C, data = datos, FUN = mean)
medias_celda[order(-medias_celda$y), ]   # ordenadas de mayor a menor
# Comparaciones múltiples de Tukey para la interacción AB
# (solo AB, porque es la interacción significativa)
TukeyHSD(modelo, which = "A:B")
# ---------- 4. (b) Verificación de supuestos ----------
# Residuos y valores ajustados
res <- residuals(modelo)
ajust <- fitted(modelo)
# Cuatro gráficos en una sola ventana
par(mfrow = c(2, 2))
# Cuatro gráficos en una sola ventana
par(mfrow = c(2, 2))
