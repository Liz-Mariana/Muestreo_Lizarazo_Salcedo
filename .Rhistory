source("C:/Users/maria/Downloads/descriptivo.R", echo = TRUE)
datos <- read.csv("datos/datos.csv")
dir.create("figuras", showWarnings = FALSE)
# Tabla por marca: tamaño, respondieron, precio medio y mediana (libras),
# porcentaje de anuncios agotados y razón media reventa / tienda
tabla <- do.call(rbind, lapply(split(datos, datos$estrato), function(d) data.frame(
estrato        = d$estrato[1],
n              = nrow(d),
respondieron   = sum(d$respondio),
precio_medio   = round(mean(d$precio), 0),
precio_mediana = round(median(d$precio), 0),
pct_agotado    = round(mean(d$agotado) * 100, 1),
razon_media    = round(mean(d$conserva, na.rm = TRUE), 2)
)))
print(tabla, row.names = FALSE)
estrato  n respondieron precio_medio precio_mediana pct_agotado razon_media
