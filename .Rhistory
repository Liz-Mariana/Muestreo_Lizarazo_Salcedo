#2
mu_T <- c(25, 38)
sd_T <- c(5, 7)
generar_mixtura <- function(n, pesos) {
u <- runif(n)
z <- ifelse(u <= pesos[1], 1, 2)
t <- numeric(n)
n1 <- sum(z == 1)
n2 <- sum(z == 2)
if (n1 > 0) t[z == 1] <- rnorm(n1, mean = mu_T[1], sd = sd_T[1])
if (n2 > 0) t[z == 2] <- rnorm(n2, mean = mu_T[2], sd = sd_T[2])
data.frame(Z = z, T = t)
}
# 2a. Simulacion de 10.000 tiempos y grafico global vs condicionales.
pesos0 <- c(0.70, 0.30)
datos0 <- generar_mixtura(10000, pesos0)
print(table(datos0$Z)/nrow(datos0))
print(aggregate(T ~ Z, data = datos0, FUN = function(x) c(media = mean(x), sd = sd(x))))
dens_mix <- function(x, pesos) {
pesos[1]*dnorm(x, mu_T[1], sd_T[1]) + pesos[2]*dnorm(x, mu_T[2], sd_T[2])
}
hist(datos0$T, breaks = 50, probability = TRUE, col = 'grey90',
main = 'P2: mixtura global y distribuciones por canal', xlab = 'T (minutos)')
lines(density(datos0$T[datos0$Z == 1]), col = 'blue', lwd = 2, lty = 2)
lines(density(datos0$T[datos0$Z == 2]), col = 'darkgreen', lwd = 2, lty = 2)
curve(dens_mix(x, pesos0), add = TRUE, col = 'red', lwd = 2)
curve(dnorm(x, mu_T[1], sd_T[1]), add = TRUE, col = 'blue', lwd = 1)
curve(dnorm(x, mu_T[2], sd_T[2]), add = TRUE, col = 'darkgreen', lwd = 1)
abline(v = 40, lty = 3)
legend('topright', bty = 'n', lwd = 2,
col = c('red', 'blue', 'darkgreen', 'black'),
lty = c(1, 2, 2, 3),
legend = c('Mixtura global (teorica)', 'Presencial (simulada)',
'Virtual (simulada)', 'T = 40'))
# 2b. P(T>40) y P(Z=2 | T>40): simulacion vs teoria (Bayes).
estimar_P <- function(datos) {
exced <- datos$T > 40
c(P_T40 = mean(exced),
P_Z2_dado_T40 = mean(datos$Z[exced] == 2),
n_excedentes = sum(exced))
}
calcular_teorico <- function(pesos) {
p1 <- 1 - pnorm(40, mu_T[1], sd_T[1])   # P(T>40 | Z=1)
p2 <- 1 - pnorm(40, mu_T[2], sd_T[2])   # P(T>40 | Z=2)
total <- pesos[1]*p1 + pesos[2]*p2      # probabilidad total
post2 <- pesos[2]*p2/total              # Bayes
c(P_T40 = total, P_Z2_dado_T40 = post2, P_T40_dado_Z1 = p1, P_T40_dado_Z2 = p2)
}
lines(density(datos0$T[datos0$Z == 1]), col = 'pink', lwd = 2, lty = 2)
curve(dnorm(x, mu_T[1], sd_T[1]), add = TRUE, col = 'pink', lwd = 1)
curve(dnorm(x, mu_T[2], sd_T[2]), add = TRUE, col = 'darkgreen', lwd = 1)
abline(v = 40, lty = 3)
legend('topright', bty = 'n', lwd = 2,
col = c('red', 'pink', 'darkgreen', 'black'),
lty = c(1, 2, 2, 3),
legend = c('Mixtura global (teorica)', 'Presencial (simulada)',
'Virtual (simulada)', 'T = 40'))
# 2b. P(T>40) y P(Z=2 | T>40): simulacion vs teoria (Bayes).
